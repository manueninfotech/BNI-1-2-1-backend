# Backend environment. Copy to .env and fill in. NEVER commit the real .env.

# Firebase Admin service account (raw JSON or base64). Production sets this in
# the host dashboard; locally you may instead point GOOGLE_APPLICATION_CREDENTIALS
# at a key file.
FIREBASE_SERVICE_ACCOUNT=

PORT=3000
NODE_ENV=development

# Comma-separated allowed origins for the admin panel. "*" for local dev only.
CORS_ORIGINS=*

# LOCAL DEV ONLY — makes every admin endpoint public.
ALLOW_INSECURE_ADMIN=false
# Exposes destructive /reset and /stop routes. Off in production.
ENABLE_DEV_ROUTES=false

# Cloudinary (agenda PDF uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — the registration-fee payment.
# The SECRET must only ever live on the server. When these are unset the server
# still boots; the payment endpoints return 503 and the app falls back to
# offline (UPI/bank) payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
