# Backend environment. Copy to .env and fill in. NEVER commit the real .env.

# PostgreSQL. Local default shown; production uses the Azure server with TLS.
DATABASE_URL=postgres://localhost:5432/conclave_dev

# Firebase Admin service account (raw JSON or base64) — used ONLY for sign-in
# (Auth) and push (FCM). Locally you may instead point
# GOOGLE_APPLICATION_CREDENTIALS at a key file.
FIREBASE_SERVICE_ACCOUNT=

# Azure Blob Storage for uploaded files (agendas). Private container.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=conclave-files

PORT=3000
NODE_ENV=development

# Comma-separated allowed origins for the admin panel. "*" for local dev only.
CORS_ORIGINS=*

# LOCAL DEV ONLY — makes every endpoint accept a fake identity. The server
# refuses to start with this on when NODE_ENV=production.
ALLOW_INSECURE_ADMIN=false
# Exposes destructive /reset and /stop routes. Off in production.
ENABLE_DEV_ROUTES=false

# Razorpay — the registration-fee payment. The SECRET lives only on the server.
# Unset → payment endpoints return 503 and the app falls back to offline payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
